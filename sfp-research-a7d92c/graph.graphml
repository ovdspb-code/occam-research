      <data key="d5">Смежные переносы</data>
      <data key="d6">["Исходный дизайн решений на каждом шаге", "Неограниченные соответствующие параметры конкурентов"]</data>
      <data key="d7">["Не человеческий эмпирический эффект", "Ценовая память — резерв, не ядро физической SFP"]</data>
