      <data key="d5">Физические интерфейсы</data>
      <data key="d6">["Сохранённые контакты и датчики", "Исходный baseline не переопределяется подключением"]</data>
      <data key="d7">["Точность описания не гарантирует доступности или прежней цены", "Размер интерфейса может расти"]</data>
