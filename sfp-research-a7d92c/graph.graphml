    <node id="aq_frequency_mobility">
      <data key="d0">Частоты опыта задают подвижности — условно</data>
      <data key="d1">При выравнивании средней неустранённой нагрузки и равных амплитудах/упругих шкалах стационарная пропорция m_i/m_j=ω_i/ω_j.</data>
      <data key="d2">hypothesis</data>
      <data key="d3">conditional</data>
